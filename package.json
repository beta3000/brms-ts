{
  "name": "brms-ts",
  "version": "1.0.2",
  "description": "Motor de reglas de negocio en TypeScript estilo Drools: reglas declarativas JSON/YAML ejecutadas por un motor de inferencia forward-chaining tipo RETE.",
  "keywords": [
    "rules",
    "rule-engine",
    "brms",
    "drools",
    "rete",
    "forward-chaining",
    "business-rules",
    "typescript"
  ],
  "license": "MIT",
  "author": "Ciro Rodriguez",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/beta3000/brms-ts.git"
  },
  "homepage": "https://github.com/beta3000/brms-ts#readme",
  "bugs": {
    "url": "https://github.com/beta3000/brms-ts/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs": "typedoc",
    "audit": "npm audit --omit=dev",
    "check:pkg": "publint --strict && attw --pack .",
    "example": "tsx examples/credit-approval/run.ts",
    "prepare": "husky",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build",
    "semantic-release": "semantic-release"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@eslint/js": "10.0.1",
    "@jest/globals": "30.5.1",
    "@semantic-release/changelog": "7.0.0",
    "@semantic-release/exec": "7.1.0",
    "@semantic-release/git": "11.0.1",
    "@semantic-release/github": "12.0.9",
    "@types/js-yaml": "4.0.9",
    "@types/node": "22.20.3",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-tsdoc": "0.5.3",
    "husky": "9.1.7",
    "jest": "30.5.1",
    "lint-staged": "17.5.1",
    "prettier": "3.9.7",
    "publint": "0.3.24",
    "semantic-release": "25.0.9",
    "ts-jest": "29.4.12",
    "tsup": "8.5.1",
    "tsx": "4.23.13",
    "typedoc": "0.28.20",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "js-yaml": "4.3.2"
  },
  "overrides": {
    "esbuild": "0.28.2"
  },
  "lint-staged": {
    "*.{ts,mts,cts}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,mjs,cjs,json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
